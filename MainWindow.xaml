<Window x:Class="GWTP_Windows_POC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GWTP Windows POC"
        Height="520"
        Width="720"
        MinHeight="480"
        MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="GWTP Windows POC"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#666666"
                       Text="Select a control, store its UI Automation identity, then find it again." />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,24,0,18"
                    Orientation="Horizontal">
            <Button x:Name="SelectElementButton"
                    Width="140"
                    Height="36"
                    Click="SelectElementButton_Click"
                    Content="Select Element" />
            <Button x:Name="FindElementButton"
                    Width="140"
                    Height="36"
                    Margin="10,0,0,0"
                    Click="FindElementButton_Click"
                    Content="Find Element"
                    IsEnabled="False" />
            <Button x:Name="OpenAmbiguityTestButton"
                    Width="170"
                    Height="36"
                    Margin="10,0,0,0"
                    Click="OpenAmbiguityTestButton_Click"
                    Content="Open Ambiguity Test" />
            <TextBlock x:Name="StatusText"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#666666"
                       Text="Ready" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="18"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Name" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NameValue" Text="—" TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Margin="0,14,0,0" FontWeight="SemiBold" Text="AutomationId" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" x:Name="AutomationIdValue" Text="—" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Margin="0,14,0,0" FontWeight="SemiBold" Text="ControlType" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" x:Name="ControlTypeValue" Text="—" TextWrapping="Wrap" />

                <TextBlock Grid.Row="3" Margin="0,14,0,0" FontWeight="SemiBold" Text="Process" />
                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,14,0,0" x:Name="ProcessValue" Text="—" TextWrapping="Wrap" />

                <TextBlock Grid.Row="4" Margin="0,14,0,0" FontWeight="SemiBold" Text="Process Id" />
                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,14,0,0" x:Name="ProcessIdValue" Text="—" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
