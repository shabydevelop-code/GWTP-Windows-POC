<Window x:Class="GWTP_Windows_POC.GuidanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Width="340"
        FontFamily="Segoe UI"
        FontSize="14"
        Foreground="#172033">
    <Border Background="White"
            BorderBrush="#D6008F"
            BorderThickness="2,3,2,2"
            CornerRadius="12"
            Padding="16,10,16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Opacity="0.22"
                              ShadowDepth="3" />
        </Border.Effect>
        <StackPanel Width="308">
            <Grid x:Name="DragHandle"
                  Height="14"
                  Margin="-10,-4,-10,8"
                  Background="Transparent"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                  ToolTip="Move guidance">
                <UniformGrid Rows="2"
                             Columns="3"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                    <Ellipse Width="4" Height="4" Margin="1.5" Fill="#94A3B8" />
                    <Ellipse Width="4" Height="4" Margin="1.5" Fill="#94A3B8" />
                    <Ellipse Width="4" Height="4" Margin="1.5" Fill="#94A3B8" />
                    <Ellipse Width="4" Height="4" Margin="1.5" Fill="#94A3B8" />
                    <Ellipse Width="4" Height="4" Margin="1.5" Fill="#94A3B8" />
                    <Ellipse Width="4" Height="4" Margin="1.5" Fill="#94A3B8" />
                </UniformGrid>
            </Grid>

            <TextBlock FontSize="14"
                       FontWeight="Medium"
                       LineHeight="22"
                       TextWrapping="Wrap"
                       Text="Enter text in the highlighted field." />

            <TextBlock x:Name="ValidationMessage"
                       Margin="0,10,0,0"
                       Foreground="#B42318"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0">
                <Button x:Name="PreviousButton"
                        MinWidth="82"
                        Height="32"
                        Padding="10,6"
                        Margin="0,0,8,0"
                        Background="White"
                        BorderBrush="#D0D5DD"
                        BorderThickness="1"
                        Content="Previous"
                        Click="PreviousButton_Click" />
                <Button x:Name="NextButton"
                        MinWidth="72"
                        Height="32"
                        Padding="10,6"
                        Background="White"
                        BorderBrush="#D0D5DD"
                        BorderThickness="1"
                        Content="Next"
                        Click="NextButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
