<Window x:Class="GWTP_Windows_POC.AmbiguityTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GWTP Ambiguity Test"
        Height="300"
        Width="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0"
                  Header="Group A"
                  AutomationProperties.AutomationId="GroupA">
            <Grid Margin="18">
                <Button Width="140"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Continue"
                        AutomationProperties.AutomationId="SharedContinue" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="2"
                  Header="Group B"
                  AutomationProperties.AutomationId="GroupB">
            <Grid Margin="18">
                <Button Width="140"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Continue"
                        AutomationProperties.AutomationId="SharedContinue" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>
